{
  "schemaVersion": 1,
  "description": "Synthetic page-pet manifest v1 cases for plan 168 S-A1. Rust (buddy_pet.rs) and TypeScript (shared/buddy-pet.ts) both run every case: valid ones pass validateManifest and, when sheets are given, the sheet-size check; each invalid one fails with exactly its rule.",
  "rules": [
    "manifest-v1",
    "frame-count",
    "puppet-retired",
    "legacy-layers",
    "pivot-range",
    "frame-id",
    "frame-expression",
    "sheet-name",
    "sheet-avif",
    "rect-square",
    "frame-kind",
    "gaze-range",
    "gaze-unique",
    "neutral-missing",
    "cell-size",
    "rect-limit",
    "frame-outside-sheet",
    "sheet-size",
    "decoded-budget"
  ],
