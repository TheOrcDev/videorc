+static char *videorc_audio_uid_hex(AVCaptureDevice *device)
+{
+    const unsigned char *uid = (const unsigned char *)[[device uniqueID] UTF8String];
+    static const char hex[] = "0123456789abcdef";
+    size_t length = uid ? strlen((const char *)uid) : 0;
+    char *encoded;
+    if (!length || length > 1024)
+        return NULL;
+    encoded = av_malloc(length * 2 + 1);
+    if (!encoded)
+        return NULL;
+    for (size_t i = 0; i < length; ++i) {
+        encoded[2 * i] = hex[uid[i] >> 4];
+        encoded[2 * i + 1] = hex[uid[i] & 15];
+    }
+    encoded[length * 2] = 0;
+    return encoded;
+}
