// Plan 242 S11-S12. ESLint parity lives in "overrides"; on top of it, the
// correctness, suspicious and perf groups of these plugins are errors, so a
// rule that passes today cannot regress. Each rule below fails today and is
// off with its count and reason: follow-ups, each its own PR.
{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "eslint",
    "typescript",
    "react",
    "import",
    "unicorn",
    "vitest",
    "oxc",
    "jsx-a11y",
    "promise"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "env": {
    "builtin": true
  },
  "ignorePatterns": [
    "node_modules/**",
    "target/**",
    "vendor/**",
    "apps/desktop/out/**",
    "apps/desktop/release/**"
  ],
  "rules": {
    // 6 today. Side-effect imports (CSS, polyfills) are intentional.
    "import/no-unassigned-import": "off",
    // 1 today. Accessibility fixes change markup and focus; their own PR.
    "jsx-a11y/click-events-have-key-events": "off",
    // 6 today. Accessibility fixes change markup and focus; their own PR.
    "jsx-a11y/control-has-associated-label": "off",
    // 1 today. Accessibility fixes change markup and focus; their own PR.
    "jsx-a11y/img-redundant-alt": "off",
    // 1 today. Accessibility fixes change markup and focus; their own PR.
    "jsx-a11y/interactive-supports-focus": "off",
