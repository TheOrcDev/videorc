    "jsx-a11y/label-has-associated-control": "off",
    // 2 today. Accessibility fixes change markup and focus; their own PR.
    "jsx-a11y/media-has-caption": "off",
    // 20 today. Accessibility fixes change markup and focus; their own PR.
    "jsx-a11y/no-autofocus": "off",
    // 9 today. Accessibility fixes change markup and focus; their own PR.
    "jsx-a11y/no-noninteractive-element-interactions": "off",
    // 4 today. Accessibility fixes change markup and focus; their own PR.
    "jsx-a11y/no-noninteractive-tabindex": "off",
    // 6 today. Accessibility fixes change markup and focus; their own PR.
    "jsx-a11y/no-static-element-interactions": "off",
    // 113 today. Accessibility fixes change markup and focus; their own PR.
    "jsx-a11y/prefer-tag-over-role": "off",
    // 2 today. Accessibility fixes change markup and focus; their own PR.
    "jsx-a11y/role-supports-aria-props": "off",
    // 291 today. Follow-up.
    "no-await-in-loop": "off",
    // 111 today. Follow-up.
    "no-shadow": "off",
    // 30 today. Follow-up.
    "no-underscore-dangle": "off",
    // 6 today. Follow-up.
    "no-unmodified-loop-condition": "off",
    // 5 today. Perf; rewriting spreads in reducers is a refactor of its own.
    "oxc/no-accumulating-spread": "off",
    // 45 today. Perf; rewriting spreads in reducers is a refactor of its own.
    "oxc/no-map-spread": "off",
    // 197 today. Promise chains change error flow when rewritten; its own PR.
    "promise/always-return": "off",
    // 27 today. Promise chains change error flow when rewritten; its own PR.
    "promise/no-callback-in-promise": "off",
    // 1 today. Promise chains change error flow when rewritten; its own PR.
    "promise/no-multiple-resolved": "off",
    // 4 today. Promise chains change error flow when rewritten; its own PR.
    "promise/no-promise-in-callback": "off",
    // 33 today. Fixing changes component behaviour; its own PR.
    "react/exhaustive-effect-dependencies": "off",
    // 5 today. Fixing changes component behaviour; its own PR.
    "react/globals": "off",
    // 4 today. Fixing changes component behaviour; its own PR.
    "react/immutability": "off",
    // 3 today. Fixing changes component behaviour; its own PR.
    "react/incompatible-library": "off",
    // 3 today. Fixing changes component behaviour; its own PR.
    "react/jsx-no-constructed-context-values": "off",
    // 4 today. Fixing changes component behaviour; its own PR.
    "react/memo-dependencies": "off",
    // 16 today. Fixing changes component behaviour; its own PR.
    "react/no-array-index-key": "off",
    // 35 today. Fixing changes component behaviour; its own PR.
    "react/no-children-prop": "off",
    // 1 today. Fixing changes component behaviour; its own PR.
    "react/no-deriving-state-in-effects": "off",
    // 11 today. Fixing changes component behaviour; its own PR.
    "react/no-object-type-as-default-prop": "off",
    // 3 today. Fixing changes component behaviour; its own PR.
    "react/no-unstable-nested-components": "off",
    // 8 today. Fixing changes component behaviour; its own PR.
    "react/preserve-manual-memoization": "off",
    // 5 today. Fixing changes component behaviour; its own PR.
    "react/purity": "off",
    // 7060 today. Not for the automatic JSX runtime (tsconfig "jsx": "react-jsx").
    "react/react-in-jsx-scope": "off",
    // 88 today. Fixing changes component behaviour; its own PR.
    "react/refs": "off",
    // 38 today. Fixing changes component behaviour; its own PR.
    "react/set-state-in-effect": "off",
    // 4 today. Static-only classes are an existing API shape; its own PR.
    "typescript/no-extraneous-class": "off",
    // 414 today. Style; hoisting closures out of components and tests is a refactor of its own.
    "unicorn/consistent-function-scoping": "off",
    // 11 today. toReversed needs the ES2023 lib; the app targets ES2022.
    "unicorn/no-array-reverse": "off",
    // 154 today. toSorted needs the ES2023 lib; the app targets ES2022.
    "unicorn/no-array-sort": "off",
    // 4 today. Mechanical; follow-up.
    "unicorn/no-new-array": "off",
    // 1 today. A test fixture builds a thenable on purpose.
    "unicorn/no-thenable": "off",
    // 1 today. Mechanical; follow-up.
    "unicorn/no-useless-fallback-in-spread": "off",
    // 5 today. Mechanical; follow-up.
    "unicorn/no-useless-spread": "off",
    // 25 today. Changes handler replacement semantics; its own PR.
    "unicorn/prefer-add-event-listener": "off",
    // 11 today. Mechanical but touches behaviour on empty results; its own PR.
    "unicorn/prefer-array-find": "off",
    // 9 today. Changes value types at call sites; its own PR.
    "unicorn/prefer-set-has": "off",
    // 7 today. Mechanical; follow-up.
    "unicorn/prefer-string-starts-ends-with": "off",
    // 1 today. Follow-up.
    "unicorn/require-module-specifiers": "off",
    // 6 today. Test style; follow-up.
    "vitest/expect-expect": "off",
    // 3 today. Test style; follow-up.
    "vitest/no-commented-out-tests": "off",
    // 71 today. Test style; follow-up.
    "vitest/no-conditional-expect": "off",
    // 1 today. Test style; follow-up.
    "vitest/no-standalone-expect": "off",
    // 1646 today. Test style; follow-up.
    "vitest/require-mock-type-parameters": "off",
    // 346 today. Test style; follow-up.
    "vitest/require-to-throw-message": "off",
    // 194 today. Test style; follow-up.
    "vitest/valid-expect": "off"
