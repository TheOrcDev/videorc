{
  "disableAllHooks": true,
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": ["Read(./**)", "Read(~/videorc/**)"],
    "deny": [
      "Bash",
      "Edit",
      "Write",
      "MultiEdit",
      "NotebookEdit",
      "WebFetch",
      "WebSearch",
      "Agent",
      "Skill",
      "Read(~/.videorc-live-lab/**)",
      "Read(~/.ssh/**)",
      "Read(~/.config/**)",
      "Read(~/.netrc)",
      "Read(~/.claude/**)",
      "Read(~/.claude.json)",
      "Read(~/.zshrc)",
      "Read(~/.zprofile)",
      "Read(~/.zshenv)",
      "Read(~/.bash_profile)",
      "Read(~/.bashrc)",
      "Read(~/Library/**)",
      "Read(//Library/Keychains/**)",
      "Read(//private/etc/**)",
      "Read(//etc/**)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(config.json)",
      "Read(run.lock)",
      "Read(**/clips/**)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh pr:*)",
      "Bash(gh workflow:*)",
      "Bash(gh api:*)",
      "Bash(node:*)",
      "Bash(pnpm:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(launchctl:*)",
      "Bash(sudo:*)",
      "Bash(rm:*)",
      "Bash(open:*)",
      "Bash(kill:*)",
      "Bash(killall:*)",
      "Bash(pkill:*)",
      "Bash(pgrep:*)",
      "Bash(cat:*)",
      "Bash(sh:*)",
      "Bash(bash:*)",
      "Bash(zsh:*)",
      "Bash(claude:*)",
      "Bash(live:*)"
    ]
  }
}
