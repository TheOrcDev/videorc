{
  "name": "@videorc/desktop",
  "version": "0.9.131",
  "private": true,
  "main": "./out/main/index.js",
  "description": "Videorc desktop app.",
  "author": "TheOrcDev",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "pnpm --dir ../.. build:native-preview-addon && electron-vite dev",
    "build": "electron-vite build",
    "package": "pnpm build && electron-builder --dir --config.mac.identity=null --config.mac.notarize=false",
    "dist": "pnpm build && electron-builder --config.mac.identity=null --config.mac.notarize=false --config.dmg.sign=false",
    "package:linux": "pnpm build && electron-builder --linux dir AppImage --publish never",
    "package:windows:unsigned": "pnpm build && electron-builder --win dir --publish never --config electron-builder.windows-unsigned.cjs",
    "dist:windows:prepackaged": "electron-builder --win nsis --publish never --prepackaged release/win-unpacked --config electron-builder.windows-signed.cjs",
    "dist:windows:signed": "pnpm dist:windows:prepackaged",
    "dist:signed": "pnpm build && electron-builder --mac dmg",
    "dist:release": "pnpm build && APPLE_TEAM_ID=C2PA37RB58 electron-builder --publish never && node scripts/staple-dmg.mjs",
    "release:upload": "node scripts/release-upload.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-virtual": "^3.14.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "electron-updater": "^6.8.9",
    "immer": "^11.1.21",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.2.0",
    "aws4fetch": "^1.0.20",
    "electron": "^44.5.1",
    "7zip-bin": "5.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "happy-dom": "^20.14.5",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.3"
  }
}
