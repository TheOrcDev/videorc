<!--
  AppStream metainfo for Videorc Linux packages (deb/rpm payloads, AUR
  package). The metadata itself is CC0-1.0; the project code is AGPL-3.0-only.
  Brand assets (the icon and name) are NOT covered by the code license — see
  apps/desktop/build-resources/README.md and TRADEMARK.md.

  Bump the <releases> entry on every release (docs/linux-distribution-packaging.md).
-->
<component type="desktop-application">
  <id>dev.theorcdev.videorc</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>AGPL-3.0-only</project_license>
  <name>Videorc</name>
  <summary>AI-native recording and livestreaming studio for creators</summary>
  <description>
    <p>
      Videorc is an AI-native recording and livestreaming studio for creators:
      screen and window capture, camera and microphone sources, recording,
      multi-destination livestreaming, captions, and scene composition, all in
      one desktop app.
    </p>
    <p>
      Linux packages bundle an LGPL-only FFmpeg build with a VAAPI hardware
      encoder path and an OpenH264 software fallback. Screen and window capture
      on Wayland go through the desktop portal.
    </p>
  </description>
  <launchable type="desktop-id">videorc.desktop</launchable>
  <url type="homepage">https://www.videorc.com</url>
  <developer id="dev.theorcdev">
    <name>TheOrcDev</name>
  </developer>
  <provides>
    <binary>videorc</binary>
  </provides>
  <categories>
    <category>AudioVideo</category>
    <category>Video</category>
  </categories>
